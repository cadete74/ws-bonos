# ---- WS Bonos (entorno) ----
# Copiá este archivo como .env y completá con tus valores reales.
# El archivo .env está gitignoreado — nunca se commitea.

# DB: en Docker usar ruta del volumen; en local: DB_PATH="$(pwd)/data/wsbonos.sqlite3"
DB_PATH=/app/data/wsbonos.sqlite3

# --- XOMS WebSocket / Eco Valores ---
XOMS_BASE_URL=https://api.eco.xoms.com.ar
XOMS_WS_URL=wss://api.eco.xoms.com.ar
XOMS_USER=<tu-usuario-eco>
XOMS_PASS=<tu-password-eco>

# Profundidad del orderbook (1..N)
ORDERBOOK_DEPTH=5
